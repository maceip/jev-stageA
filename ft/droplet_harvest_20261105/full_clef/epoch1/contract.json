   "EmptyCriteria": "choice or score without criteria: '<id>: criteria must not be empty'",
   "SchemaTooLong": "prefix + picture + schema + suffix > max_length (16384), encode_record's message",
   "EmptyRecord": "no ids or no questions, encode_record's message",
   "UnsupportedMedia": "host only: more than one picture, videos, media_kwargs, an unreadable picture or URL, a tile other than 256 / 448",
   "RequestTooLong": "host only: more than 4096 tokens (refused, never truncated)",
   "base": "every refusal is clef_litert.RequestError, a ValueError"
  }
 },
 "ids": {
  "encode": "tokenizers.Tokenizer.from_file(tokenizer.json).encode(piece, add_special_tokens=False), pieces concatenated (the author's encode_record)",
  "prefix": "<|im_start|>system\nRead the complete state and schema. Decide every field jointly. Each answer must be exactly one of that field's allowed options.<|im_end|>\n<|im_start|>user\nSTATE:\n",
  "prefix_ids": 36,
  "suffix": "\n<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\nJOINT SCHEMA DECISIONS:",
  "suffix_ids": 18,
  "schema_header": "\n\nSCHEMA FIELDS:\n",
  "question_piece": "\\nFIELD {i}\\nID: {id}\\nTYPE: {type}\\nINSTRUCTION: [render(instructions or id)]\\nALLOWED OPTIONS:\\n + per option 'OPTION {j}: [render({option_id, description})]\\n' + 'END FIELD\\n' ([..] = the spans)",
  "render": "a string as is, else json.dumps(ensure_ascii=False, separators=(',', ':'), sort_keys=True)",
  "option_order": "noul (true, false); choice: ids sorted as strings; score: levels 0..n-1",
  "noul_default_criteria": {
   "true": "The proposition is true or the answer is yes.",
   "false": "The proposition is false or the answer is no."
  },
  "picture_block": "<|vision_start|> + N x <|image_pad|> + <|vision_end|> + '\\n' right after the prefix (token_offset = the <|vision_start|> index)",
  "state_cut": "to max_length 16384 exactly as encode_record (the row graphs refuse past 4096 first)",
  "usage_input_tokens": "len(ids)"
 },
